# Copy to .env and fill
APP_ENV=dev
APP_SECRET=change_me_long_random

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=domain_watch
DB_USER=domain_watch
DB_PASS=CHANGE_ME_PASSWORD

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 23時の実行を「その日の最後」として全文保存
LAST_HOUR=23

# runnerの並列数（0/1なら逐次）
RUNNER_CONCURRENCY=1
