# Copy to .env and fill
APP_ENV=dev
APP_SECRET=change_me_long_random

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=domain_watch
DB_USER=domain_watch
DB_PASS=CHANGE_ME_PASSWORD

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_WEB_SEARCH=1
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low
OPENAI_WEB_SEARCH_COUNTRY=JP
OPENAI_WEB_SEARCH_TIMEZONE=Asia/Tokyo
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_WEB_SEARCH=1

# API keys configured for these providers are measured on each scheduled run.
RUNNER_PROVIDERS=openai,gemini

# 1日3回の取得時刻（Asia/Tokyo）
RUN_HOURS=0,8,16

# runnerの並列数（0/1なら逐次）
RUNNER_CONCURRENCY=1
